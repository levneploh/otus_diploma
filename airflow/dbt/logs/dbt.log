      t.database as schema,
      multiIf(
        t.engine = 'MaterializedView', 'materialized_view',
        t.engine = 'View', 'view',
        t.engine = 'Dictionary', 'dictionary',
        'table'
      ) as type,
      db.engine as db_engine,
      groupArrayIf(
