"_message": "OK", "query_id": "f269c872-8fdc-44f1-b809-c17a1fd45db8"}, "message": "OK", "failures": null, "unique_id": "model.dwh.dim_categories", "compiled": true, "compiled_code": "\n\nSELECT\n    category_id,\n    name AS category_name,\n    parent_id\nFROM `dwh`.`stg_categories`", "relation_name": "`dwh`.`dim_categories`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.308136Z", "completed_at": "2026-09-15T12:52:18.311641Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.314956Z", "completed_at": "2026-09-15T12:52:18.357538Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0501251220703125, "adapter_response": {"_message": "OK", "query_id": "2d31be9d-1507-42b6-82df-783b8cbb39b2"}, "message": "OK", "failures": null, "unique_id": "model.dwh.dim_vas_types", "compiled": true, "compiled_code": "\n\nSELECT\n    vas_type_id,\n    name AS vas_type_name,\n    description\nFROM `dwh`.`stg_vas_types`", "relation_name": "`dwh`.`dim_vas_types`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.291138Z", "completed_at": "2026-09-15T12:52:18.295277Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.296588Z", "completed_at": "2026-09-15T12:52:18.433046Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.14655470848083496, "adapter_response": {"_message": "OK", "query_id": "25458bd0-3132-4ebe-b816-8eddd7ef3726"}, "message": "OK", "failures": null, "unique_id": "model.dwh.mart_listings_by_category", "compiled": true, "compiled_code": "\n\nSELECT\n    category_id,\n    category_name,\n    count(*) AS listing_count,\n    round(avg(price), 2) AS avg_price\nFROM `dwh`.`int_listings_enriched`\nGROUP BY category_id, category_name\nORDER BY listing_count DESC", "relation_name": "`dwh`.`mart_listings_by_category`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.369116Z", "completed_at": "2026-09-15T12:52:18.373478Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.373770Z", "completed_at": "2026-09-15T12:52:18.463469Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.09570741653442383, "adapter_response": {"_message": "OK", "query_id": "d392ffb7-25ed-455c-904c-b4958f42f151"}, "message": "OK", "failures": null, "unique_id": "model.dwh.mart_revenue_daily", "compiled": true, "compiled_code": "\n\nSELECT\n    toDate(payment_date) AS day,\n    sum(amount) AS revenue\nFROM `dwh`.`int_payments_success`\nGROUP BY day\nORDER BY day", "relation_name": "`dwh`.`mart_revenue_daily`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.438319Z", "completed_at": "2026-09-15T12:52:18.448150Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.448897Z", "completed_at": "2026-09-15T12:52:18.640850Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.20380330085754395, "adapter_response": {"_message": "OK", "query_id": "55eb9360-335d-4883-a40e-85cdb65f1576"}, "message": "OK", "failures": null, "unique_id": "model.dwh.mart_revenue_monthly_yoy", "compiled": true, "compiled_code": "\n\nWITH monthly AS (\n    SELECT\n        toStartOfMonth(payment_date) AS month,\n        sum(amount) AS revenue\n    FROM `dwh`.`int_payments_success`\n    GROUP BY month\n)\nSELECT\n    m.month,\n    m.revenue,\n    p.revenue AS revenue_prev_year,\n    round((m.revenue - p.revenue) / p.revenue, 4) AS yoy_growth\nFROM monthly m\nLEFT JOIN monthly p ON p.month = addMonths(m.month, -12)\nORDER BY m.month", "relation_name": "`dwh`.`mart_revenue_monthly_yoy`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.470457Z", "completed_at": "2026-09-15T12:52:18.474560Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.474987Z", "completed_at": "2026-09-15T12:52:18.643625Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.17720413208007812, "adapter_response": {"_message": "OK", "query_id": "c393bfb5-789a-4bb3-9420-ea1d4fa56253"}, "message": "OK", "failures": null, "unique_id": "model.dwh.mart_vas", "compiled": true, "compiled_code": "\n\nSELECT\n    v.vas_type_id,\n    v.vas_type_name,\n    count(*) AS purchases,\n    sum(p.amount) AS revenue\nFROM `dwh`.`int_payments_success` p\nJOIN `dwh`.`dim_vas_types` v ON p.vas_type_id = v.vas_type_id\nWHERE p.payment_type = 'vas'\nGROUP BY v.vas_type_id, v.vas_type_name\nORDER BY revenue DESC", "relation_name": "`dwh`.`mart_vas`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.335394Z", "completed_at": "2026-09-15T12:52:18.339792Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.340404Z", "completed_at": "2026-09-15T12:52:19.225811Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.8921182155609131, "adapter_response": {"_message": "OK", "query_id": "49b8a2b7-540e-416c-a052-2ebea54900be"}, "message": "OK", "failures": null, "unique_id": "model.dwh.mart_arpu_monthly", "compiled": true, "compiled_code": "\n\nWITH revenue AS (\n    SELECT\n        toStartOfMonth(payment_date) AS month,\n        sum(amount) AS revenue\n    FROM `dwh`.`int_payments_success`\n    GROUP BY month\n),\nmau AS (\n    SELECT\n        toStartOfMonth(ts) AS month,\n        uniqExact(user_id) AS active_users\n    FROM `dwh`.`stg_user_activity`\n    GROUP BY month\n)\nSELECT\n    r.month,\n    r.revenue,\n    m.active_users,\n    round(r.revenue / m.active_users, 2) AS arpu\nFROM revenue r\nJOIN mau m ON m.month = r.month\nORDER BY r.month", "relation_name": "`dwh`.`mart_arpu_monthly`", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-15T12:52:18.289463Z", "completed_at": "2026-09-15T12:52:18.295122Z"}, {"name": "execute", "started_at": "2026-09-15T12:52:18.295464Z", "completed_at": "2026-09-15T12:52:19.321794Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.0355188846588135, "adapter_response": {"_message": "OK", "query_id": "3548ac78-abfe-4e08-880d-504c051b45ae"}, "message": "OK", "failures": null, "unique_id": "model.dwh.mart_dau", "compiled": true, "compiled_code": "\n\nSELECT\n    toDate(ts) AS day,\n    platform,\n    uniqExact(user_id) AS dau\nFROM `dwh`.`stg_user_activity`\nGROUP BY day, platform\nORDER BY day, platform", "relation_name": "`dwh`.`mart_dau`", "batch_results": null}], "elapsed_time": 1.5926287174224854, "args": {"log_level": "info", "introspect": true, "cache_selected_only": false, "log_path": "/opt/airflow/dbt/logs", "favor_state": false, "populate_cache": true, "upload_to_artifacts_ingest_api": false, "static_parser": true, "project_dir": "/opt/airflow/dbt", "use_colors_file": true, "vars": {}, "require_batched_execution_for_custom_microbatch_strategy": false, "use_colors": true, "state_modified_compare_more_unrendered_values": false, "send_anonymous_usage_stats": true, "version_check": true, "select": [], "partial_parse_file_diff": true, "partial_parse": true, "print": true, "require_all_warnings_handled_by_warn_error": false, "source_freshness_run_project_hooks": true, "write_json": true, "indirect_selection": "eager", "log_file_max_bytes": 10485760, "invocation_command": "dbt run", "profiles_dir": "/opt/airflow/dbt/profiles", "skip_nodes_if_on_run_start_fails": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "exclude": [], "require_ref_searches_node_package_before_root": false, "require_explicit_package_overrides_for_builtin_materializations": true, "use_fast_test_edges": false, "warn_error_options": {"error": [], "warn": [], "silence": []}, "require_unique_project_resource_names": false, "log_level_file": "debug", "require_nested_cumulative_type_params": false, "quiet": false, "printer_width": 80, "require_resource_names_without_spaces": true, "log_format_file": "debug", "state_modified_compare_vars": false, "defer": false, "macro